# Obrigatória
# Chave de API do Apify. Obtenha em https://console.apify.com/account/integrations
APIFY_API_KEY=sua_chave_aqui

# Opcionais — valores padrão abaixo

# Ator do Apify usado para coletar os dados do Instagram
APIFY_ACTOR=apify/instagram-scraper

# Limite de resultados retornados pelo Apify por link
RESULTS_LIMIT=100

# Mínimo de palavras para um comentário ser considerado "qualificado"
QUALIFIED_COMMENT_MIN_WORDS=5

# Modelo do Transformers usado para análise de sentimento
SENTIMENT_MODEL=nlptown/bert-base-multilingual-uncased-sentiment

# Nível e formato dos logs
LOG_LEVEL=DEBUG
LOG_FORMAT=json

# Quantidade de top posts a destacar nos gráficos
TOP_POSTS_LIMIT=10

# DPI dos gráficos PNG exportados
CHART_DPI=150

# Motor de escrita de arquivos Excel
XLSX_ENGINE=openpyxl

# Modelo do spaCy para NLP (tokenização, lematização, etc.)
SPACY_MODEL=pt_core_news_sm

# Modelo de embeddings usado pelo BERTopic
BERTOPIC_EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# Limites de geração de termos e tópicos
NLP_TOP_TERMS_LIMIT=20
NLP_TOPIC_COUNT=10
NLP_TOPIC_TERMS_LIMIT=10
NLP_SENTIMENT_TERMS_LIMIT=10
